# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
DEN_VERSION=0.18.40
OPENWORK_SERVER_VERSION=0.18.40
OPENCODE_VERSION=1.18.18

DEN_OWNER_EMAIL=you@example.com
DEN_ORG_NAME=Garza

MYSQL_ROOT_PASSWORD=
BETTER_AUTH_SECRET=
DEN_DB_ENCRYPTION_KEY=
# One-time code for creating the first owner account at http://localhost:3005/setup
DEN_INITIAL_ADMIN_BOOTSTRAP_CODE=

# Public origins (local defaults shown; on Railway these come from RAILWAY_PUBLIC_DOMAIN)
DEN_WEB_ORIGIN=http://localhost:3005
DEN_API_ORIGIN=http://localhost:8788
WORKER_ORIGIN=http://localhost:8787

# Worker tokens (leave blank to let openwork-server generate and log them)
OPENWORK_TOKEN=
OPENWORK_HOST_TOKEN=
OPENWORK_APPROVAL_MODE=manual

# Optional
RESEND_API_KEY=
EMAIL_FROM=Garza Den <no-reply@example.com>
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
